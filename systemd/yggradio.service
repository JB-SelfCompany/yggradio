[Unit]
Description=YggRadio - Decentralized Radio Platform
Documentation=https://github.com/JB-SelfCompany/yggradio
After=network.target yggdrasil.service
Wants=yggdrasil.service

[Service]
Type=simple
User=yggradio
Group=yggradio
ExecStart=/usr/local/bin/yggradio-linux
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

# Resource limits
LimitNOFILE=8192
MemoryMax=512M

[Install]
WantedBy=multi-user.target
